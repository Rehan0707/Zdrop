ZDROP_STORAGE=local
# Required for Supabase mode (default on Vercel):
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional Firebase mode:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=
CRON_SECRET=
RATE_LIMIT_SECRET=
ZDROP_AUTH_SECRET=
# Set true only when your reverse proxy overwrites x-forwarded-for.
ZDROP_TRUST_PROXY=false
