# Local mode needs no cloud keys. Hosted mode: supabase (current) or firebase (optional).
ZDROP_STORAGE=local
# Server only; configure ONE of the two Supabase keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ZDROP_AUTH_SECRET=
RATE_LIMIT_SECRET=
CRON_SECRET=
# Firebase Google sign-in: public project configuration, no admin key.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional Firebase Storage adapter. Billing must remain disabled unless approved.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=
# Dedicated station only; never NEXT_PUBLIC_. Keep browser mode without hardware.
ZDROP_PRINT_MODE=browser
ZDROP_STATION_KEY=
# Set true only when your reverse proxy overwrites x-forwarded-for.
ZDROP_TRUST_PROXY=false
