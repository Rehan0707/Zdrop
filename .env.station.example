# Copy to an ignored .env.station.local on a trusted macOS/Linux station.
# Use a dedicated restricted OS service account, separate from the shop browser.
ZDROP_STATION_URL=http://localhost:3000
# Same independent random key as the app server, never a Supabase/Firebase service key.
ZDROP_STATION_KEY=
# One administrator-approved physical CUPS queue, never a PDF/file output queue.
ZDROP_PRINTER=
